module

public import TieredMatching.TranscriptKernel
public import TieredMatching.Schedules

/-! # Ordinal proposer protocols, including suspended entrants

A protocol selects a man from the revealed ordinal transcript alone. Invalid selections are
paused. Exact transcript fibers expose only selected men's destination prefixes and the seen
ordinal row constraints. No future priorities or preference suffixes are inputs to the protocol.
-/

@[expose] public section

namespace TieredMatching.Protocols

open StableMarriage TieredMatching.Ordinal Arrival

/-- A proposer rule sees only the finite revealed ordinal history. Returning `none` suspends
the execution even if some other man could propose. -/
abbrev Protocol (n : ℕ) := List (Entry n) → Option (Fin n)

/-- Sanitize a protocol's selected man by checking only visible freedom and list exhaustion.
This is independent of raw priorities and all unrevealed preference-list entries. -/
def selected {n : ℕ} (C : Protocol n) (h : List (Entry n)) : Option (Fin n) :=
  (C h).filter fun m ↦ (recordState h).next m < n ∧ ∀ w, (recordState h).held w ≠ some m

/-- Every actual selection is a free man with a still untried candidate. -/
theorem selected_some_spec {n : ℕ} (C : Protocol n) (h : List (Entry n)) (m : Fin n)
    (hm : selected C h = some m) :
    (recordState h).next m < n ∧ ∀ w, (recordState h).held w ≠ some m := by
  have hp := (Option.filter_eq_some_iff.mp hm).2
  simpa using hp

/-- A legal selected man is exactly the protocol's original choice; sanitization adds no
choice of a different man. -/
theorem selected_eq_of_eligible {n : ℕ} (C : Protocol n) (h : List (Entry n)) (m : Fin n)
    (hm : C h = some m)
    (hel : (recordState h).next m < n ∧ ∀ w, (recordState h).held w ≠ some m) :
    selected C h = some m := by
  simpa only [selected, hm, Option.filter_some, decide_eq_true_eq] using (ite_eq_left hel :
    (if (recordState h).next m < n ∧ ∀ w, (recordState h).held w ≠ some m
      then some m else none) = some m)

/-- The next actual edge uses the protocol and the selected man's exposed-prefix counter. -/
def nextEdge {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (h : List (Entry n)) : Option (Edge n) :=
  match selected C h with
  | none => none
  | some m => if hn : (recordState h).next m < n then
      some ((P m).symm ⟨(recordState h).next m, hn⟩, m) else none

/-- The edge rule preserves the selected-man projection exactly. -/
theorem nextEdge_map_man {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (h : List (Entry n)) : (nextEdge C P h).map Prod.snd = selected C h := by
  cases hm : selected C h with
  | none => simp only [nextEdge, hm, Option.map_none]
  | some m =>
    have hn := (selected_some_spec C h m hm).1
    simp only [nextEdge, hm, dite_eq_left hn, Option.map_some]

/-- A selected edge has the next candidate of the selected free man. -/
theorem nextEdge_some_spec {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (h : List (Entry n)) (q : Edge n) (hq : nextEdge C P h = some q) :
    ∃ m, ∃ hn : (recordState h).next m < n,
      selected C h = some m ∧ q = ((P m).symm ⟨(recordState h).next m, hn⟩, m) ∧
        ∀ w, (recordState h).held w ≠ some m := by
  unfold nextEdge at hq
  split at hq
  · contradiction
  · rename_i m hm
    split at hq
    · rename_i hn
      exact ⟨m, hn, hm, (Option.some.inj hq).symm, (selected_some_spec C h m hm).2⟩
    · contradiction

/-- A protocol's observable record uses the same raw acceptance comparison as the exact PR. -/
noncomputable def observation {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (x : Edge n → ℝ) (h : List (Entry n)) : Entry n :=
  (nextEdge C P h).map fun q ↦ (q, Ordinal.accept x (recordState h) q)

/-- The exact finite ordinal transcript generated by this possibly suspending protocol. -/
noncomputable def transcript {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (x : Edge n → ℝ) : ℕ → List (Entry n)
  | 0 => []
  | t + 1 => let h := transcript C P x t; observation C P x h :: h

/-- A fixed transcript selects exactly the edges prescribed by its protocol and rankings. -/
def ValidProtocol {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n)) :
    List (Entry n) → Prop
  | [] => True
  | entry :: h => ValidProtocol C P h ∧ nextEdge C P h = entry.map Prod.fst

/-- Protocol scheduling legality is entirely preference-independent. -/
def ScheduleValid {n : ℕ} (C : Protocol n) : List (Entry n) → Prop
  | [] => True
  | entry :: h => ScheduleValid C h ∧ selected C h = entry.map (fun e ↦ e.1.2)

/-- All observations in a fixed transcript agree with the protocol's revealed comparisons. -/
def Observes {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (x : Edge n → ℝ) : List (Entry n) → Prop
  | [] => True
  | entry :: h => Observes C P x h ∧ observation C P x h = entry

/-- One protocol record exposes only its discrete edge and the same seen-row comparison as
in the canonical PR execution. -/
theorem observation_eq_iff {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (x : Edge n → ℝ) (h : List (Entry n)) (entry : Entry n) :
    observation C P x h = entry ↔ nextEdge C P h = entry.map Prod.fst ∧
      ∀ w, RowConstraint (recordState h) entry w (fun m ↦ x (w, m)) := by
  cases entry with
  | none => simp [observation, RowConstraint]
  | some entry =>
    rcases entry with ⟨q, accepted⟩
    change observation C P x h = some (q, accepted) ↔ nextEdge C P h = some q ∧ _
    rw [← accept_eq_iff_rows]
    rcases q with ⟨w, m⟩
    simp [observation, Option.map_eq_some_iff, Prod.mk.injEq]

/-- Exact fixed-history factorization for every history-dependent proposer protocol. -/
theorem observes_iff_valid_rows {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ) (h : List (Entry n)) :
    Observes C P x h ↔ ValidProtocol C P h ∧
      ∀ w, RowFiber h w (fun m ↦ x (w, m)) := by
  induction h with
  | nil => simp [Observes, ValidProtocol, RowFiber]
  | cons entry h ih =>
    simp only [Observes, ValidProtocol, RowFiber, ih, observation_eq_iff, forall_and]
    tauto

/-- Observed records characterize the protocol's actual generated transcript. -/
theorem observes_iff_transcript {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ) (h : List (Entry n)) :
    Observes C P x h ↔ transcript C P x h.length = h := by
  induction h with
  | nil => simp [Observes, transcript]
  | cons entry h ih =>
    change (Observes C P x h ∧ observation C P x h = entry) ↔
      observation C P x (transcript C P x h.length) :: transcript C P x h.length = entry :: h
    constructor
    · rintro ⟨hprev, hentry⟩
      rw [ih.mp hprev, hentry]
    · intro heq
      have htail := (List.cons.inj heq).2
      have hentry := (List.cons.inj heq).1
      rw [htail] at hentry
      exact ⟨ih.mpr htail, hentry⟩

/-- There is one record, possibly a pause, per protocol time step. -/
theorem transcript_length {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (x : Edge n → ℝ) (t : ℕ) : (transcript C P x t).length = t := by
  induction t with
  | zero => rfl
  | succ t ih => simpa only [transcript, List.length_cons] using congrArg Nat.succ ih

/-- Exact finite protocol fibers do not reveal any future preferences or unqueried priority. -/
theorem transcript_eq_iff {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (x : Edge n → ℝ) (t : ℕ) (h : List (Entry n)) :
    transcript C P x t = h ↔ h.length = t ∧ ValidProtocol C P h ∧
      ∀ w, RowFiber h w (fun m ↦ x (w, m)) := by
  constructor
  · intro heq
    have hlen : h.length = t := heq ▸ transcript_length C P x t
    refine ⟨hlen, ?_⟩
    exact (observes_iff_valid_rows C P x h).mp
      ((observes_iff_transcript C P x h).mpr (by simpa only [hlen] using heq))
  · rintro ⟨hlen, hvalid, hrows⟩
    have heq := (observes_iff_transcript C P x h).mp
      ((observes_iff_valid_rows C P x h).mpr ⟨hvalid, hrows⟩)
    simpa only [hlen] using heq

/-- Exact protocol fibers on the product of seen-coordinate ordinal events. Unseen priorities
are completely absent from the right-hand side. -/
theorem transcript_eq_iff_seenRows {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ) (t : ℕ) (h : List (Entry n)) :
    transcript C P x t = h ↔ h.length = t ∧ ValidProtocol C P h ∧
      ∀ w, (fun m : SeenMen h w ↦ x (w, m.val)) ∈ seenRowEvent h w := by
  rw [transcript_eq_iff]
  constructor
  · rintro ⟨hlen, hvalid, hrows⟩
    exact ⟨hlen, hvalid, fun w ↦
      (rowFiber_iff_seenRowEvent h w (fun m ↦ x (w, m))).mp (hrows w)⟩
  · rintro ⟨hlen, hvalid, hrows⟩
    exact ⟨hlen, hvalid, fun w ↦
      (rowFiber_iff_seenRowEvent h w (fun m ↦ x (w, m))).mpr (hrows w)⟩

/-- Every fixed protocol transcript has a measurable fiber in the raw priority array. -/
theorem measurableSet_transcript_fiber {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (t : ℕ) (h : List (Entry n)) :
    MeasurableSet {x : Edge n → ℝ | transcript C P x t = h} := by
  have heq : {x : Edge n → ℝ | transcript C P x t = h} =
      {x | (h.length = t ∧ ValidProtocol C P h) ∧ ∀ w, RowFiber h w (fun m ↦ x (w, m))} := by
    ext x
    change (transcript C P x t = h) ↔
      ((h.length = t ∧ ValidProtocol C P h) ∧ ∀ w, RowFiber h w (fun m ↦ x (w, m)))
    simpa only [and_assoc] using transcript_eq_iff C P x t h
  rw [heq]
  by_cases hgood : h.length = t ∧ ValidProtocol C P h
  · simp only [hgood, true_and, Set.ofPred_forall]
    apply MeasurableSet.iInter
    intro w
    have hm : Measurable (fun x : Edge n → ℝ ↦ fun m : Fin n ↦ x (w, m)) :=
      Measurable.of_eval (fun m ↦ measurable_pi_apply (w, m))
    exact (measurableSet_rowFiber h w).preimage hm
  · simp [hgood]

/-- A legal next destination extends exactly one man's exposed list prefix. -/
theorem prefixes_record_iff {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (h : List (Entry n)) (w m : Fin n) (a : Bool)
    (hs : selected C h = some m) :
    (∀ k, (manOrder (some ((w, m), a) :: h) k).IsPrefix (List.ofFn (P k).symm)) ↔
      (∀ k, (manOrder h k).IsPrefix (List.ofFn (P k).symm)) ∧
        nextEdge C P h = some (w, m) := by
  classical
  have hn := (selected_some_spec C h m hs).1
  have hval : (List.ofFn (P m).symm)[(manOrder h m).length]? =
      some ((P m).symm ⟨(recordState h).next m, hn⟩) := by
    simp [length_manOrder, hn]
  have hedge : nextEdge C P h = some (w, m) ↔
      (P m).symm ⟨(recordState h).next m, hn⟩ = w := by
    simp only [nextEdge, hs, dite_eq_left hn, Option.some.injEq, Prod.mk.injEq, and_true]
  rw [hedge]
  constructor
  · intro hall
    have hm := hall m
    simp only [manOrder, ite_true, prefix_append_singleton_iff, hval,
      Option.some.injEq] at hm
    refine ⟨fun k ↦ ?_, hm.2⟩
    by_cases hk : k = m
    · simpa only [hk] using hm.1
    · simpa only [manOrder, ite_eq_right (Ne.symm hk)] using hall k
  · rintro ⟨hall, hnext⟩ k
    by_cases hk : k = m
    · subst k
      simp only [manOrder, ite_true, prefix_append_singleton_iff, hval,
        Option.some.injEq]
      exact ⟨hall m, hnext⟩
    · simpa only [manOrder, ite_eq_right (Ne.symm hk)] using hall k

/-- Exact deterministic factorization: the PR transcript constrains only scheduler legality
and the chronological exposed prefix of each man's ranking. It never reveals hidden suffixes. -/
theorem valid_iff_schedule_prefixes {n : ℕ} (C : Protocol n) (P : Fin n → Equiv.Perm (Fin n))
    (h : List (Entry n)) :
    ValidProtocol C P h ↔ ScheduleValid C h ∧
      ∀ m, (manOrder h m).IsPrefix (List.ofFn (P m).symm) := by
  induction h with
  | nil => simp [ValidProtocol, ScheduleValid, manOrder]
  | cons entry h ih =>
    cases entry with
    | none =>
      have hedge : nextEdge C P h = none ↔
          selected C h = none := by
        constructor
        · intro hn
          simpa only [hn, Option.map_none] using (nextEdge_map_man C P h).symm
        · intro hn
          simp only [nextEdge, hn]
      simp only [ValidProtocol, ScheduleValid, manOrder, Option.map_none, ih, hedge]
      tauto
    | some e =>
      rcases e with ⟨⟨w, m⟩, a⟩
      constructor
      · rintro ⟨hprev, hnext⟩
        have hs : selected C h = some m := by
          have hh := nextEdge_map_man C P h
          simpa only [hnext, Option.map_some] using hh.symm
        have hp := ih.mp hprev
        exact ⟨⟨hp.1, hs⟩, (prefixes_record_iff C P h w m a hs).mpr ⟨hp.2, hnext⟩⟩
      · rintro ⟨⟨hschedule, hs⟩, hp⟩
        have hh := (prefixes_record_iff C P h w m a hs).mp hp
        exact ⟨ih.mpr ⟨hschedule, hh.1⟩, hh.2⟩


/-- Fully separated exact fiber: preference-independent protocol legality, exposed men's
prefixes, and a product of seen-only women's ordinal events. -/
theorem transcript_eq_iff_schedule_prefixes_seenRows {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ) (t : ℕ) (h : List (Entry n)) :
    transcript C P x t = h ↔ h.length = t ∧ ScheduleValid C h ∧
      (∀ m, (manOrder h m).IsPrefix (List.ofFn (P m).symm)) ∧
      ∀ w, (fun m : SeenMen h w ↦ x (w, m.val)) ∈ seenRowEvent h w := by
  rw [transcript_eq_iff_seenRows, valid_iff_schedule_prefixes]
  tauto

/-- Valid protocol records expose exactly the actual strict-list proposal prefixes. -/
theorem seenEdges_iff_hasProposed {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (h : List (Entry n))
    (hv : ValidProtocol C P h) (q : Edge n) :
    q ∈ seenEdges h ↔ HasProposed ⟨P, fun _ ↦ Equiv.refl _⟩ (recordState h) q.2 q.1 := by
  induction h with
  | nil => simp [seenEdges, recordState, HasProposed]
  | cons entry h ih =>
    rcases hv with ⟨hprev, hnext⟩
    cases entry with
    | none => exact ih hprev
    | some entry =>
      rcases entry with ⟨edge, accepted⟩
      obtain ⟨m, hn, _, rfl, _⟩ := nextEdge_some_spec C P h edge hnext
      change q ∈ insert _ (seenEdges h) ↔
        HasProposed ⟨P, fun _ ↦ Equiv.refl _⟩
          ⟨Function.update (recordState h).next m ((recordState h).next m + 1), _⟩ q.2 q.1
      rw [hasProposed_update_iff _ _ _ hn, Finset.mem_insert, ih hprev]
      simp only [Prod.ext_iff, and_comm, or_comm]

/-- Every next proposal is fresh, even when previous steps suspended other eligible men. -/
theorem nextEdge_fresh_of_valid {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (h : List (Entry n))
    (hv : ValidProtocol C P h) (q : Edge n) (hq : nextEdge C P h = some q) :
    q ∉ seenEdges h := by
  intro hseen
  have hp := (seenEdges_iff_hasProposed C P h hv q).mp hseen
  obtain ⟨m, hn, _, rfl, _⟩ := nextEdge_some_spec C P h q hq
  change (P m ((P m).symm ⟨(recordState h).next m, hn⟩)).val < _ at hp
  simp only [Equiv.apply_symm_apply, lt_self_iff_false] at hp

/-- Generated histories always satisfy their exact protocol legality condition. -/
theorem transcript_valid {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ) (t : ℕ) :
    ValidProtocol C P (transcript C P x t) :=
  ((transcript_eq_iff C P x t _).mp rfl).2.1

/-- The generated transcript's row constraints hold on the actual priority array. -/
theorem transcript_rowFiber {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ) (t : ℕ) (w : Fin n) :
    RowFiber (transcript C P x t) w (fun m ↦ x (w, m)) :=
  ((transcript_eq_iff C P x t _).mp rfl).2.2 w

/-- Actual next-edge freshness needs no separate process validity assumption. -/
theorem nextEdge_fresh_transcript {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ) (t : ℕ) (q : Edge n)
    (hq : nextEdge C P (transcript C P x t) = some q) :
    q ∉ seenEdges (transcript C P x t) :=
  nextEdge_fresh_of_valid C P _ (transcript_valid C P x t) q hq

/-- Acceptance after any generated protocol history is exactly a race against the seen men;
combined with freshness this is the deterministic interface for the exponential race kernel. -/
theorem accept_true_iff_seen_transcript {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ) (t : ℕ) (w m : Fin n) :
    Ordinal.accept x (recordState (transcript C P x t)) (w, m) = true ↔
      ∀ k : SeenMen (transcript C P x t) w, x (w, m) < x (w, k.val) :=
  accept_true_iff_all_seen _ w m x (transcript_rowFiber C P x t w)

/-- The active-set condition is local to the actually revealed history. Other men may remain
suspended, and selected men can be activated at arbitrary times. -/
def Uses {n : ℕ} (A : Finset (Fin n)) (C : Protocol n) : List (Entry n) → Prop
  | [] => True
  | _ :: h => Uses A C h ∧ ∀ m, selected C h = some m → m ∈ A

/-- Any ordinal protocol uses the full entrant set, regardless of suspensions. -/
theorem uses_univ {n : ℕ} (C : Protocol n) (h : List (Entry n)) :
    Uses Finset.univ C h := by
  induction h with
  | nil => trivial
  | cons entry h ih => exact ⟨ih, fun _ _ ↦ Finset.mem_univ _⟩

/-- An actual selected observation is the exact chosen-man proposal operation from the PR. -/
theorem recordStep_observation_eq_propose {n : ℕ} (C : Protocol n) (p : Profile n)
    (x : Edge n → ℝ)
    (hc : ∀ w m old, x (w, m) < x (w, old) ↔ p.womanRank w m < p.womanRank w old)
    (h : List (Entry n)) (m : Fin n) (hm : selected C h = some m) :
    recordStep (recordState h) (observation C p.manRank x h) =
      Schedules.propose p (recordState h) m (selected_some_spec C h m hm).1 := by
  have hn := (selected_some_spec C h m hm).1
  simp only [observation, nextEdge, hm, dite_eq_left hn, Option.map_some,
    recordStep, accept, Schedules.propose, hc]
  rfl

/-- Every legal fixed protocol transcript replays to a genuine partial-entrant DA state.
This is a conclusion from the exposed comparisons, not an assumed final-closure property. -/
theorem recordState_reachable {n : ℕ} (C : Protocol n) (p : Profile n)
    (x : Edge n → ℝ)
    (hc : ∀ w m old, x (w, m) < x (w, old) ↔ p.womanRank w m < p.womanRank w old)
    (A : Finset (Fin n)) (h : List (Entry n)) (ho : Observes C p.manRank x h)
    (hu : Uses A C h) : Schedules.Reachable p A (recordState h) := by
  induction h with
  | nil => exact Schedules.Reachable.initial
  | cons entry h ih =>
    rcases ho with ⟨hoprev, hentry⟩
    rcases hu with ⟨huprev, hactive⟩
    have hr := ih hoprev huprev
    change Schedules.Reachable p A (recordStep (recordState h) entry)
    rw [← hentry]
    cases hm : selected C h with
    | none => simpa only [observation, nextEdge, hm, Option.map_none, recordStep] using hr
    | some m =>
      rw [recordStep_observation_eq_propose C p x hc h m hm]
      exact hr.step m ⟨hactive m hm, selected_some_spec C h m hm⟩

/-- Tie-free priority rows give genuine partial DA semantics for every generated protocol. -/
theorem transcript_reachable {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ)
    (hx : ∀ w, Function.Injective (fun m ↦ x (w, m)))
    (A : Finset (Fin n)) (t : ℕ) (hu : Uses A C (transcript C P x t)) :
    Schedules.Reachable (Arrival.profile P x) A (recordState (transcript C P x t)) := by
  apply recordState_reachable C (Arrival.profile P x) x
    (fun w m old ↦ (exponentialRank_lt_iff _ (hx w) m old).symm) A _ _ hu
  apply (observes_iff_transcript C P x _).mpr
  rw [transcript_length]

/-- Terminating a partial-entrant protocol yields the unique partial DA state. -/
theorem transcript_terminal_eq_active {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ)
    (hx : ∀ w, Function.Injective (fun m ↦ x (w, m)))
    (A : Finset (Fin n)) (t : ℕ) (hu : Uses A C (transcript C P x t))
    (ht : Schedules.Terminal A (recordState (transcript C P x t))) :
    recordState (transcript C P x t) = Schedules.activeDeferredAcceptance (Arrival.profile P x) A :=
  Schedules.terminal_state_eq_active _ A (transcript_reachable C P x hx A t hu) ht

/-- Once all entrants have reached a terminal state, any ordinal protocol agrees exactly
with the PR implementation, including every proposal counter and every held man. -/
theorem transcript_terminal_eq_pr {n : ℕ} (C : Protocol n)
    (P : Fin n → Equiv.Perm (Fin n)) (x : Edge n → ℝ)
    (hx : ∀ w, Function.Injective (fun m ↦ x (w, m))) (t : ℕ)
    (ht : Schedules.Terminal Finset.univ (recordState (transcript C P x t))) :
    recordState (transcript C P x t) = deferredAcceptance (Arrival.profile P x) :=
  Schedules.terminal_state_eq_pr _
    (transcript_reachable C P x hx Finset.univ t (uses_univ C _)) ht

end TieredMatching.Protocols
